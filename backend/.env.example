# GameVerse 307 Backend Configuration (.env)

# Telegram Bot Token (Obtén uno hablando con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Supabase Credentials (Proyecto gratuito en supabase.com)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Port & Environment
PORT=3001
NODE_ENV="production"

# URL pública de tu Hub GameVerse 307 (Cloudflare Pages gratis o tu dominio gameverse307.com)
WEBAPP_URL="https://gameverse307.pages.dev"

# Opcional: URL pública de este backend (ej: https://gameverse307-api.onrender.com) para usar Webhook
# Si se deja vacío usa polling automático
WEBHOOK_URL=""
